rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.id == userId
        && data.validatedDates is list
        && data.validatedDates.size() <= 10000;
    }

    // User personal hydration profile and dates
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
